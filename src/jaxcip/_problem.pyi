from collections.abc import Sequence
from pathlib import Path

import numpy as np
from jaxtyping import Float, Int

from jaxcip._block import BlockHandle
from jaxcip._handler import FunctionHandle
from jaxcip._options import HandlerOptions
from jaxcip._types import (
    BlockTerm,
    Domain,
    Emphasis,
    JaxTerm,
    ParameterType,
    ScipVersion,
    Sense,
    Status,
)

ParameterValue = bool | int | float | str

class ScipError(RuntimeError): ...

def forward_blas() -> int: ...
def scip_version() -> ScipVersion: ...
def parameter_table() -> tuple[tuple[str, ParameterType, str], ...]: ...

class Scip:
    handles: list[FunctionHandle | BlockHandle]
    def __init__(self, name: str) -> None: ...
    @staticmethod
    def read(path: Path) -> Scip: ...
    def write(self, path: Path) -> None: ...
    @property
    def infinity(self) -> float: ...
    @property
    def num_variables(self) -> int: ...
    @property
    def variable_names(self) -> tuple[str, ...]: ...
    def add_variable(
        self, lower: float, upper: float, objective: float, domain: Domain
    ) -> int: ...
    def add_linear_constraint(
        self,
        indices: Int[np.ndarray, " k"],
        coefficients: Float[np.ndarray, " k"],
        lower: float,
        upper: float,
    ) -> None: ...
    def variable_array(self, indices: Int[np.ndarray, " k"]) -> np.ndarray: ...
    def add_jax_constraint(
        self,
        terms: Sequence[JaxTerm | BlockTerm],
        linear_indices: Int[np.ndarray, " k"],
        linear_coefficients: Float[np.ndarray, " k"],
        constant: float,
        lower: float,
        upper: float,
        options: HandlerOptions,
    ) -> None: ...
    def set_sense(self, sense: Sense) -> None: ...
    def add_objective_offset(self, offset: float) -> None: ...
    def set_emphasis(self, emphasis: Emphasis) -> None: ...
    def set_parameter(self, name: str, value: ParameterValue) -> None: ...
    def get_parameter(self, name: str) -> ParameterValue: ...
    def solve(self) -> None: ...
    @property
    def status(self) -> Status: ...
    @property
    def primal_bound(self) -> float: ...
    @property
    def dual_bound(self) -> float: ...
    @property
    def gap(self) -> float: ...
    @property
    def nodes(self) -> int: ...
    @property
    def solving_time(self) -> float: ...
    def best_solution(self) -> tuple[float, Float[np.ndarray, " n"]] | None: ...
    def check_solution(self, values: Float[np.ndarray, " n"]) -> bool: ...
    def solve_copy(self) -> tuple[float, int]: ...
    def hessian_direction(
        self,
        term: JaxTerm | BlockTerm,
        options: HandlerOptions,
        x: Float[np.ndarray, " n"],
        direction: Float[np.ndarray, " n"],
    ) -> Float[np.ndarray, " k"] | None: ...
