# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-x86_64-darwin
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.x86_64-apple-darwin.tar.gz
source_filename = Zlib.v1.3.2.x86_64-apple-darwin.tar.gz
source_hash = 023e98a21c7c713a4524f74eb978f64b1f3780c2dcac32d02302a426d23e68ea
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Zlib-x86_64-darwin