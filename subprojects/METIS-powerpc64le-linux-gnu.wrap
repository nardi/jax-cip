# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-powerpc64le-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.powerpc64le-linux-gnu.tar.gz
source_filename = METIS.v5.1.4.powerpc64le-linux-gnu.tar.gz
