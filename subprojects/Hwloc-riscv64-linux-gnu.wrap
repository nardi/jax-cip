# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Hwloc-riscv64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Hwloc_jll.jl/releases/download/Hwloc-v2.15.0+0/Hwloc.v2.15.0.riscv64-linux-gnu.tar.gz
