# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-aarch64-linux-gnu-cxx11
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.aarch64-linux-gnu-cxx11.tar.gz
source_filename = boost.v1.87.0.aarch64-linux-gnu-cxx11.tar.gz
source_hash = 1912c69d8ab36eba4fcf2e30d1535a5b2266efb438227c1998d68e0cb6a66fa0
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = boost-aarch64-linux-gnu-cxx11