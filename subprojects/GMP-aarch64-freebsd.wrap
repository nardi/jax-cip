# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = GMP-aarch64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/GMP_jll.jl/releases/download/GMP-v6.3.0+5/GMP.v6.3.0.aarch64-unknown-freebsd.tar.gz
source_filename = GMP.v6.3.0.aarch64-unknown-freebsd.tar.gz
source_hash = edb366ff5b79451e7bbd55adf7cf89211554dc00fab7fc6ec82ec8e24861677b
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = GMP-aarch64-freebsd