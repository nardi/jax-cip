# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-x86_64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.x86_64-linux-gnu.tar.gz
source_filename = Zlib.v1.3.2.x86_64-linux-gnu.tar.gz
source_hash = b9b82fcdbb893ca7470e326b9fa305ece5bf5f462004a622cfdbf54c5d8de4e5
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Zlib-x86_64-linux-gnu