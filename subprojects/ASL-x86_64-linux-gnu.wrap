# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = ASL-x86_64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/ASL_jll.jl/releases/download/ASL-v0.1.5+0/ASL.v0.1.5.x86_64-linux-gnu.tar.gz
source_filename = ASL.v0.1.5.x86_64-linux-gnu.tar.gz
source_hash = 11d8f91e5374a161ed28b247ac5b28c6a42dcb4420251a2b4f7db029edc4695c
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = ASL-x86_64-linux-gnu