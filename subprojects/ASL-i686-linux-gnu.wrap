# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = ASL-i686-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/ASL_jll.jl/releases/download/ASL-v0.1.5+0/ASL.v0.1.5.i686-linux-gnu.tar.gz
