# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-x86_64-windows
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.x86_64-w64-mingw32.tar.gz
source_filename = Zlib.v1.3.2.x86_64-w64-mingw32.tar.gz
source_hash = aa9d6eeb4b3d43e07318c0b08c96c31f61d49b74a265453fd3630d281c51ba33
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Zlib-x86_64-windows