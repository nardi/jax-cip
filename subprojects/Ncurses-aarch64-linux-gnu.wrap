# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Ncurses-aarch64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Ncurses_jll.jl/releases/download/Ncurses-v6.6.0+2/Ncurses.v6.6.0.aarch64-linux-gnu.tar.gz
source_filename = Ncurses.v6.6.0.aarch64-linux-gnu.tar.gz
source_hash = 8a596ef5a53f127fa79da52f6f30ccd41033ab8b569d0497171079b67710b658
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Ncurses-aarch64-linux-gnu