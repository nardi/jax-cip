# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-powerpc64le-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.powerpc64le-linux-gnu.tar.gz
source_filename = Zlib.v1.3.2.powerpc64le-linux-gnu.tar.gz
source_hash = ffe5ed8cbf11d1a07f073267599caafe21e91fa1130681e4c3d748bf0a346d03
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Zlib-powerpc64le-linux-gnu