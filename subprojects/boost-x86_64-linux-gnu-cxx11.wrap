# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-x86_64-linux-gnu-cxx11
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.x86_64-linux-gnu-cxx11.tar.gz
source_filename = boost.v1.87.0.x86_64-linux-gnu-cxx11.tar.gz
source_hash = 4d503214f46216c6f8cba40dd7148bd0b411e0286d216a93641fa02afcdf5dc6
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = boost-x86_64-linux-gnu-cxx11