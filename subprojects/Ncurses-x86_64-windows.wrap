# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Ncurses-x86_64-windows
source_url = https://github.com/JuliaBinaryWrappers/Ncurses_jll.jl/releases/download/Ncurses-v6.6.0+2/Ncurses.v6.6.0.x86_64-w64-mingw32.tar.gz
