# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-riscv64-linux-gnu-cxx11
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.riscv64-linux-gnu-cxx11.tar.gz
source_filename = boost.v1.87.0.riscv64-linux-gnu-cxx11.tar.gz
source_hash = da4a1bbf9cf4aca50280cdcc40a519f7278cd92aff443b3b28b0c197bd5cb2a0
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = boost-riscv64-linux-gnu-cxx11