# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-aarch64-linux-musl
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.aarch64-linux-musl.tar.gz
source_filename = METIS.v5.1.4.aarch64-linux-musl.tar.gz
source_hash = dfd1d0f6be7aefbea6bdc822f42f770876dc4eb29f05729c6014a5c0d0a4513d
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = METIS-aarch64-linux-musl