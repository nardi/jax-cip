# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Hwloc-aarch64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/Hwloc_jll.jl/releases/download/Hwloc-v2.15.0+0/Hwloc.v2.15.0.aarch64-unknown-freebsd.tar.gz
source_filename = Hwloc.v2.15.0.aarch64-unknown-freebsd.tar.gz
