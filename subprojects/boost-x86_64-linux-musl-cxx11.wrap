# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-x86_64-linux-musl-cxx11
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.x86_64-linux-musl-cxx11.tar.gz
