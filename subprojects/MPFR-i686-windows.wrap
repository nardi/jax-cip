# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = MPFR-i686-windows
source_url = https://github.com/JuliaBinaryWrappers/MPFR_jll.jl/releases/download/MPFR-v4.2.2+1/MPFR.v4.2.2.i686-w64-mingw32.tar.gz
source_filename = MPFR.v4.2.2.i686-w64-mingw32.tar.gz
