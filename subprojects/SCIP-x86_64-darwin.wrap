# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = SCIP-x86_64-darwin
source_url = https://github.com/JuliaBinaryWrappers/SCIP_jll.jl/releases/download/SCIP-v1000.100.0+0/SCIP.v1000.100.0.x86_64-apple-darwin.tar.gz
