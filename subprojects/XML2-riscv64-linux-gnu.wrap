# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = XML2-riscv64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/XML2_jll.jl/releases/download/XML2-v2.15.4+0/XML2.v2.15.4.riscv64-linux-gnu.tar.gz
