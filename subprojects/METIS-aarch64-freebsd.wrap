# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-aarch64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.aarch64-unknown-freebsd.tar.gz
source_filename = METIS.v5.1.4.aarch64-unknown-freebsd.tar.gz
source_hash = 4b690224fc88f617022ed15d512327a21be98e32b2ba257d037f06a1fae73ef5
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = METIS-aarch64-freebsd