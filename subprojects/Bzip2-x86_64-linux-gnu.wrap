# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Bzip2-x86_64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Bzip2_jll.jl/releases/download/Bzip2-v1.0.9+0/Bzip2.v1.0.9.x86_64-linux-gnu.tar.gz
source_filename = Bzip2.v1.0.9.x86_64-linux-gnu.tar.gz
source_hash = 82a946d20bc79d3b0ba4df99db413f52730128b19ee2806f248a4410f22532a1
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Bzip2-x86_64-linux-gnu