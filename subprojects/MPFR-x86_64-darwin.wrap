# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = MPFR-x86_64-darwin
source_url = https://github.com/JuliaBinaryWrappers/MPFR_jll.jl/releases/download/MPFR-v4.2.2+1/MPFR.v4.2.2.x86_64-apple-darwin.tar.gz
source_filename = MPFR.v4.2.2.x86_64-apple-darwin.tar.gz
source_hash = d2b1896df47a29f482b02c6b388f82cc34a09df5be154b34fadec0b6437e782a
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = MPFR-x86_64-darwin