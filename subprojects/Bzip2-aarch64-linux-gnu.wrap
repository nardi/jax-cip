# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Bzip2-aarch64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Bzip2_jll.jl/releases/download/Bzip2-v1.0.9+0/Bzip2.v1.0.9.aarch64-linux-gnu.tar.gz
source_filename = Bzip2.v1.0.9.aarch64-linux-gnu.tar.gz
source_hash = 3bddaf572b7146720d3263f1d34bce141f0ac4c936e661ebd76533cc0fffcca5
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Bzip2-aarch64-linux-gnu