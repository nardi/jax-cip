# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-x86_64-darwin
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.x86_64-apple-darwin.tar.gz
source_filename = METIS.v5.1.4.x86_64-apple-darwin.tar.gz
source_hash = 799f81b062869a5db09d3bedc171676e5b42ccce3ad93fde1cdfa86d8fc08127
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = METIS-x86_64-darwin