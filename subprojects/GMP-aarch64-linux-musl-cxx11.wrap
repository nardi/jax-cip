# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = GMP-aarch64-linux-musl-cxx11
source_url = https://github.com/JuliaBinaryWrappers/GMP_jll.jl/releases/download/GMP-v6.3.0+5/GMP.v6.3.0.aarch64-linux-musl-cxx11.tar.gz
