# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Ncurses-powerpc64le-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Ncurses_jll.jl/releases/download/Ncurses-v6.6.0+2/Ncurses.v6.6.0.powerpc64le-linux-gnu.tar.gz
