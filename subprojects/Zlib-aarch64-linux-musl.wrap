# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-aarch64-linux-musl
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.aarch64-linux-musl.tar.gz
source_filename = Zlib.v1.3.2.aarch64-linux-musl.tar.gz
source_hash = be85af8d55e54a88f3b01f636ab71a47d833513c98b80c9b3fbc784e911b5224
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Zlib-aarch64-linux-musl