# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = GMP-x86_64-darwin
source_url = https://github.com/JuliaBinaryWrappers/GMP_jll.jl/releases/download/GMP-v6.3.0+5/GMP.v6.3.0.x86_64-apple-darwin.tar.gz
source_filename = GMP.v6.3.0.x86_64-apple-darwin.tar.gz
source_hash = 76318d451857619ad1f82276fd65a9ea69e15fe8e38acbd1c8a2dc725b1ade41
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = GMP-x86_64-darwin