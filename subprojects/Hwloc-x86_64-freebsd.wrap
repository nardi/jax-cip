# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Hwloc-x86_64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/Hwloc_jll.jl/releases/download/Hwloc-v2.15.0+0/Hwloc.v2.15.0.x86_64-unknown-freebsd.tar.gz
source_filename = Hwloc.v2.15.0.x86_64-unknown-freebsd.tar.gz
source_hash = 39b2c3f3590a05021bd4fbeb90fa300dbaf8f793226a65c651e067696a258c40
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Hwloc-x86_64-freebsd