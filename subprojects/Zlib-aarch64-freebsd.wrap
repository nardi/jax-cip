# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-aarch64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.aarch64-unknown-freebsd.tar.gz
source_filename = Zlib.v1.3.2.aarch64-unknown-freebsd.tar.gz
source_hash = 4fc7436fc7a4668b64333dc9c0d872bb5cad8470da861005a5aa78b14bf86784
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Zlib-aarch64-freebsd