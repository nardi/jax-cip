# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Bzip2-i686-windows
source_url = https://github.com/JuliaBinaryWrappers/Bzip2_jll.jl/releases/download/Bzip2-v1.0.9+0/Bzip2.v1.0.9.i686-w64-mingw32.tar.gz
