# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-x86_64-windows
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.x86_64-w64-mingw32.tar.gz
source_filename = METIS.v5.1.4.x86_64-w64-mingw32.tar.gz
