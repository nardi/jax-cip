# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Readline-aarch64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Readline_jll.jl/releases/download/Readline-v8.3.3+0/Readline.v8.3.3.aarch64-linux-gnu.tar.gz
source_filename = Readline.v8.3.3.aarch64-linux-gnu.tar.gz
source_hash = da7982fd10e2e3b6e4efde0d7c3c6e7e73265d22f821309ae200b7977670aa05
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Readline-aarch64-linux-gnu