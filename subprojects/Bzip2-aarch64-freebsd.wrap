# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Bzip2-aarch64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/Bzip2_jll.jl/releases/download/Bzip2-v1.0.9+0/Bzip2.v1.0.9.aarch64-unknown-freebsd.tar.gz
source_filename = Bzip2.v1.0.9.aarch64-unknown-freebsd.tar.gz
source_hash = c77b45376c17736adbb9a579025cca200eeb83605413f427ebd1dc0dc770c799
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Bzip2-aarch64-freebsd