# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-x86_64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.x86_64-linux-gnu.tar.gz
source_filename = METIS.v5.1.4.x86_64-linux-gnu.tar.gz
source_hash = 7449fced56b90c21907f0efd7a2e959bd612cc606dbb3daa7e82a5d4a2b6dc62
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = METIS-x86_64-linux-gnu