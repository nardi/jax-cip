# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = SCIP-x86_64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/SCIP_jll.jl/releases/download/SCIP-v1000.100.0+0/SCIP.v1000.100.0.x86_64-unknown-freebsd.tar.gz
source_filename = SCIP.v1000.100.0.x86_64-unknown-freebsd.tar.gz
source_hash = 2176adf909ef3ee1ff7d5c489ee8f5ef069eff3f12df611b710af52cc7373278
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = SCIP-x86_64-freebsd