# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = ASL-riscv64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/ASL_jll.jl/releases/download/ASL-v0.1.5+0/ASL.v0.1.5.riscv64-linux-gnu.tar.gz
source_filename = ASL.v0.1.5.riscv64-linux-gnu.tar.gz
source_hash = 9fe261aeb3fb9e2e7a34c4867ab6a9427a4f3bf7c9726ab8a752ffa5ab90e8b0
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = ASL-riscv64-linux-gnu