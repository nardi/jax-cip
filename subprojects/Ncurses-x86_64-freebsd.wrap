# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Ncurses-x86_64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/Ncurses_jll.jl/releases/download/Ncurses-v6.6.0+2/Ncurses.v6.6.0.x86_64-unknown-freebsd.tar.gz
source_filename = Ncurses.v6.6.0.x86_64-unknown-freebsd.tar.gz
source_hash = 494f8cf2beba7390df011e83475ade37324091995054899ddbd3963d41959702
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Ncurses-x86_64-freebsd