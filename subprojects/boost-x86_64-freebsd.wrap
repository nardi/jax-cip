# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-x86_64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.x86_64-unknown-freebsd.tar.gz
source_filename = boost.v1.87.0.x86_64-unknown-freebsd.tar.gz
source_hash = ba1029de0c692706ef2dba4c7e91a87a4f5c2e982d55223c1aef723a92e35b93
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = boost-x86_64-freebsd