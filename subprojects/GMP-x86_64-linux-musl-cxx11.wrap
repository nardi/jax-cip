# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = GMP-x86_64-linux-musl-cxx11
source_url = https://github.com/JuliaBinaryWrappers/GMP_jll.jl/releases/download/GMP-v6.3.0+5/GMP.v6.3.0.x86_64-linux-musl-cxx11.tar.gz
source_filename = GMP.v6.3.0.x86_64-linux-musl-cxx11.tar.gz
source_hash = 801681c16d5c51ccef423d3d7790512b65a249f45080f3b4e3e03f5be303723d
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = GMP-x86_64-linux-musl-cxx11