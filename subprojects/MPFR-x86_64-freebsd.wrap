# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = MPFR-x86_64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/MPFR_jll.jl/releases/download/MPFR-v4.2.2+1/MPFR.v4.2.2.x86_64-unknown-freebsd.tar.gz
source_filename = MPFR.v4.2.2.x86_64-unknown-freebsd.tar.gz
source_hash = 1709e3a14aa842c2bca73fbf6ee7cf90cd8da6bacd747e1a2d92e6152e73ada7
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = MPFR-x86_64-freebsd