# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Libiconv-riscv64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Libiconv_jll.jl/releases/download/Libiconv-v1.18.0+0/Libiconv.v1.18.0.riscv64-linux-gnu.tar.gz
