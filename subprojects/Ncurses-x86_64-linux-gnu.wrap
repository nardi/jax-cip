# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Ncurses-x86_64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Ncurses_jll.jl/releases/download/Ncurses-v6.6.0+2/Ncurses.v6.6.0.x86_64-linux-gnu.tar.gz
source_filename = Ncurses.v6.6.0.x86_64-linux-gnu.tar.gz
source_hash = 479d168ab9391933ad2b1c176e7a5c429e34d72166abd7c17947ba56117c600c
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Ncurses-x86_64-linux-gnu