# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Bzip2-riscv64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Bzip2_jll.jl/releases/download/Bzip2-v1.0.9+0/Bzip2.v1.0.9.riscv64-linux-gnu.tar.gz
source_filename = Bzip2.v1.0.9.riscv64-linux-gnu.tar.gz
source_hash = 02fd02139f4fe3246eab316742716cd403d091e3bb2fa4ada6b55ba28f81eeb1
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Bzip2-riscv64-linux-gnu