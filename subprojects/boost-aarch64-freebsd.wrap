# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-aarch64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.aarch64-unknown-freebsd.tar.gz
source_filename = boost.v1.87.0.aarch64-unknown-freebsd.tar.gz
source_hash = d46f25e25d0ef689f7a0333ec1c0851d06a368293b1e0a17e92520bdf6271ebb
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = boost-aarch64-freebsd