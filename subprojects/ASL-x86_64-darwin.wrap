# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = ASL-x86_64-darwin
source_url = https://github.com/JuliaBinaryWrappers/ASL_jll.jl/releases/download/ASL-v0.1.5+0/ASL.v0.1.5.x86_64-apple-darwin.tar.gz
source_filename = ASL.v0.1.5.x86_64-apple-darwin.tar.gz
source_hash = 3719d7ea0fb6eda505b5c51c4ef97255522e39075ee9bc79e52a04ca9ed0c51b
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = ASL-x86_64-darwin