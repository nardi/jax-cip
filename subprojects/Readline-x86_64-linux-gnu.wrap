# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Readline-x86_64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/Readline_jll.jl/releases/download/Readline-v8.3.3+0/Readline.v8.3.3.x86_64-linux-gnu.tar.gz
