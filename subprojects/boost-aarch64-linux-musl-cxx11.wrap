# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-aarch64-linux-musl-cxx11
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.aarch64-linux-musl-cxx11.tar.gz
source_filename = boost.v1.87.0.aarch64-linux-musl-cxx11.tar.gz
source_hash = de323ad0a39e8f554b49e5f8db82ac6c3f9190dcd2f94d876fa1077c760a5b4e
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = boost-aarch64-linux-musl-cxx11