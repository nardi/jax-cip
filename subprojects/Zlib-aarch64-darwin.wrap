# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-aarch64-darwin
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.aarch64-apple-darwin.tar.gz
