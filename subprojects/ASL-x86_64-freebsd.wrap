# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = ASL-x86_64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/ASL_jll.jl/releases/download/ASL-v0.1.5+0/ASL.v0.1.5.x86_64-unknown-freebsd.tar.gz
source_filename = ASL.v0.1.5.x86_64-unknown-freebsd.tar.gz
source_hash = 876131e36d945034c6946570bce4f41061d59dd03713429286b2bfb7b026ebcb
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = ASL-x86_64-freebsd