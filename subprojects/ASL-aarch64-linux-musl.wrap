# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = ASL-aarch64-linux-musl
source_url = https://github.com/JuliaBinaryWrappers/ASL_jll.jl/releases/download/ASL-v0.1.5+0/ASL.v0.1.5.aarch64-linux-musl.tar.gz
source_filename = ASL.v0.1.5.aarch64-linux-musl.tar.gz
source_hash = e6fd5021600be5585e108aa26751d72b800c162be76cdee620a287fce47101f4
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = ASL-aarch64-linux-musl