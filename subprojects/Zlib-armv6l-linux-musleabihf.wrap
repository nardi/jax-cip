# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Zlib-armv6l-linux-musleabihf
source_url = https://github.com/JuliaBinaryWrappers/Zlib_jll.jl/releases/download/Zlib-v1.3.2+0/Zlib.v1.3.2.armv6l-linux-musleabihf.tar.gz
