# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = MPFR-aarch64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/MPFR_jll.jl/releases/download/MPFR-v4.2.2+1/MPFR.v4.2.2.aarch64-linux-gnu.tar.gz
source_filename = MPFR.v4.2.2.aarch64-linux-gnu.tar.gz
source_hash = 4db8a64de693094828ea81d4e43c6cd0c403dab9f20ab68a6172fd15d9699bf0
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = MPFR-aarch64-linux-gnu