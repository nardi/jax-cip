# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = MPFR-i686-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/MPFR_jll.jl/releases/download/MPFR-v4.2.2+1/MPFR.v4.2.2.i686-linux-gnu.tar.gz
source_filename = MPFR.v4.2.2.i686-linux-gnu.tar.gz
source_hash = 39711781fe0c7f0112a683dc6ae1d04483f86303a5f1c90e26cfb49ae6fe71ff
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = MPFR-i686-linux-gnu