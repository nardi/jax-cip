# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = MPFR-riscv64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/MPFR_jll.jl/releases/download/MPFR-v4.2.2+1/MPFR.v4.2.2.riscv64-linux-gnu.tar.gz
source_filename = MPFR.v4.2.2.riscv64-linux-gnu.tar.gz
source_hash = 2d3b891263bb06c9bb24ca0ca240097b3b222dbe37dc8bcd6e5f3f9e70f636c0
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = MPFR-riscv64-linux-gnu