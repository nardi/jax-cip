# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-i686-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.i686-linux-gnu.tar.gz
