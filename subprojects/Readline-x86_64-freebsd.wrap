# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Readline-x86_64-freebsd
source_url = https://github.com/JuliaBinaryWrappers/Readline_jll.jl/releases/download/Readline-v8.3.3+0/Readline.v8.3.3.x86_64-unknown-freebsd.tar.gz
source_filename = Readline.v8.3.3.x86_64-unknown-freebsd.tar.gz
source_hash = ef6ca0e7c4ab6e2101d7a1ee0cdd388d4eea8202b04e981c265c344f5f99deaa
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Readline-x86_64-freebsd