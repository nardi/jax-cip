# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = Bzip2-x86_64-linux-musl
source_url = https://github.com/JuliaBinaryWrappers/Bzip2_jll.jl/releases/download/Bzip2-v1.0.9+0/Bzip2.v1.0.9.x86_64-linux-musl.tar.gz
source_filename = Bzip2.v1.0.9.x86_64-linux-musl.tar.gz
source_hash = 449941e440a6912654154ae0167b56d4e6a5a473e83ba6af9ac0809e7f43d58a
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = Bzip2-x86_64-linux-musl