# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = boost-i686-linux-musl-cxx11
source_url = https://github.com/JuliaBinaryWrappers/boost_jll.jl/releases/download/boost-v1.87.0+0/boost.v1.87.0.i686-linux-musl-cxx11.tar.gz
source_filename = boost.v1.87.0.i686-linux-musl-cxx11.tar.gz
source_hash = b9b9b7ab30e8fcf8e9af0c6177363bc68c2d0cf8f366c3e19fa3209bb4dd3917
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = boost-i686-linux-musl-cxx11