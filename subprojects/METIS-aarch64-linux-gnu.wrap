# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = METIS-aarch64-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/METIS_jll.jl/releases/download/METIS-v5.1.4+0/METIS.v5.1.4.aarch64-linux-gnu.tar.gz
source_filename = METIS.v5.1.4.aarch64-linux-gnu.tar.gz
source_hash = f8d59ee9840fc38d4ed6092528cd5223b11f8667c8f874474dbd692b2d5c2813
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = METIS-aarch64-linux-gnu