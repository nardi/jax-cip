# This platform's tarball, straight from the JLL's own release assets.
[wrap-file]
directory = ASL-powerpc64le-linux-gnu
source_url = https://github.com/JuliaBinaryWrappers/ASL_jll.jl/releases/download/ASL-v0.1.5+0/ASL.v0.1.5.powerpc64le-linux-gnu.tar.gz
source_filename = ASL.v0.1.5.powerpc64le-linux-gnu.tar.gz
source_hash = 6d230e1f6836950b51e511154e7a56b4b4e69b10daf32f02b311ec35eab1484f
# The JLL's tarballs are flat archives with no leading directory.
lead_directory_missing = true
# Drops in the meson.build this platform's tarball does not ship.
patch_directory = ASL-powerpc64le-linux-gnu